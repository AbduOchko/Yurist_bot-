# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
WEBHOOK_URL=https://your-app.railway.app

# Database (Railway provides this automatically)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/yurist_bot

# AI — llmost.ru (GPT-4o)
LLMOST_API_KEY=your_llmost_api_key_here
LLMOST_BASE_URL=https://llmost.ru/api/v1
LLMOST_MODEL=openai/gpt-4o
# Модель, принимающая голос как input_audio в /chat/completions
LLMOST_AUDIO_MODEL=openai/gpt-4o-audio-preview

# Первый владелец — создаётся один раз при старте если нет ни одного owner-а
# в БД. Длина пароля минимум 12. После первого логина смените пароль в панели.
OWNER_BOOTSTRAP_LOGIN=owner
OWNER_BOOTSTRAP_PASSWORD=change_me_to_a_long_random_secret

# App
WEBAPP_URL=https://your-app.railway.app
PORT=8000
HOST=0.0.0.0

# Upload settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800
