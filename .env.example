# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
WEBHOOK_URL=https://your-app.railway.app

# Database (Railway provides this automatically)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/yurist_bot

# AI — Sber GigaChat (https://developers.sber.ru/studio)
# GIGACHAT_AUTH_KEY — «Authorization Key» из личного кабинета (длинная base64-строка).
GIGACHAT_AUTH_KEY=your_authorization_key_here
# Scope: GIGACHAT_API_PERS (физлицо) | GIGACHAT_API_B2B | GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
# Сертификаты Сбера от НУЦ Минцифры обычно не в системном хранилище → оставьте false
GIGACHAT_VERIFY_SSL=false

# Владелец — создаётся при старте, если его ещё нет в staff-таблице.
# Вход во все панели (владелец/менеджер/юрист) идёт ТОЛЬКО по логину и паролю,
# из любого Telegram-аккаунта, по инлайн-кнопке бота (/owner, /manager, /lawyer).
# telegram_id для доступа НЕ нужен.
#
# OWNER_BOOTSTRAP_TELEGRAM_ID — НЕОБЯЗАТЕЛЕН. Можно оставить пустым: тогда
# заведётся один владелец с логином OWNER_BOOTSTRAP_LOGIN. Если указать список
# ID через запятую — на каждый создаётся отдельная строка владельца (первый
# получает логин как есть, остальные — <login>_<id>); это просто способ завести
# несколько владельцев за один деплой, на доступ ID не влияет.
OWNER_BOOTSTRAP_LOGIN=owner
OWNER_BOOTSTRAP_PASSWORD=change_me_to_a_long_random_secret
OWNER_BOOTSTRAP_TELEGRAM_ID=

# App
WEBAPP_URL=https://your-app.railway.app
PORT=8000
HOST=0.0.0.0

# Upload settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800
