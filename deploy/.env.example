# Скопировать в deploy/.env на сервере и заполнить. В git НЕ коммитится (см. .gitignore).
# DATABASE_URL задаётся в docker-compose.yml (внутренняя база), сюда его класть НЕ нужно.

# Пароль внутренней базы (любой длинный секрет — используется и в compose, и базой)
DB_PASSWORD=change_me_strong_db_password

# Telegram
BOT_TOKEN=your_bot_token
# Домен юрист-бота на этом сервере (HTTPS через общий Caddy). Оба — один и тот же адрес.
WEBAPP_URL=https://yurist.example.ru
WEBHOOK_URL=https://yurist.example.ru

# Sber GigaChat
GIGACHAT_AUTH_KEY=your_authorization_key
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_VERIFY_SSL=false

# Владелец (создаётся при старте, если его ещё нет; при переносе базы уже существует)
OWNER_BOOTSTRAP_LOGIN=owner
OWNER_BOOTSTRAP_PASSWORD=change_me_to_a_long_random_secret
OWNER_BOOTSTRAP_TELEGRAM_ID=

# Файлы
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800
